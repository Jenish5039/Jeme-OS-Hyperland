#!/usr/bin/env bash
# ==============================================================================
# Jeme OS — Unified Desktop CLI
# Complete management & automation CLI for Jeme OS (Hyprland & DWM editions)
# ==============================================================================
set -euo pipefail

VERSION="2.0.0-dwm"

# Colors for CLI output
GREEN="\033[1;32m"
BLUE="\033[1;34m"
YELLOW="\033[1;33m"
CYAN="\033[1;36m"
RED="\033[1;31m"
BOLD="\033[1m"
RESET="\033[0m"

pass() { echo -e "  [${GREEN}PASS${RESET}] $1"; }
warn() { echo -e "  [${YELLOW}WARN${RESET}] $1"; }
fail() { echo -e "  [${RED}FAIL${RESET}] $1"; }

show_help() {
    cat << EOF
${BOLD}Jeme OS CLI${RESET} — Unified Desktop Management Utility (v${VERSION})

${BOLD}USAGE:${RESET}
  jeme <command> [arguments...]

${BOLD}COMMANDS:${RESET}
  ${CYAN}launch${RESET} <app>          Launch default applications (terminal, browser, filemanager,
                               calculator, emojipicker, settings, launcher, ai)
  ${CYAN}wifi${RESET} [action]          Manage Wi-Fi (toggle, on, off, status, menu)
  ${CYAN}bluetooth${RESET} [action]     Manage Bluetooth (toggle, on, off, status, menu)
  ${CYAN}audio${RESET} <action>         Control volume and sinks (up, down, mute, mic-mute, status)
  ${CYAN}brightness${RESET} <action>    Control LCD brightness (up, down, set <pct>, get)
  ${CYAN}media${RESET} <action>         Control MPRIS media players (play-pause, next, prev, status)
  ${CYAN}power${RESET} [action]         System power operations (status, profile [name], lock,
                               logout, suspend, reboot, shutdown)
  ${CYAN}screenshot${RESET} [mode]     Take screenshot (full, area, window)
  ${CYAN}lock${RESET}                   Lock the active desktop session
  ${CYAN}wallpaper${RESET} [action]     Manage wallpaper (set <path>, random, toggle-engine, status)
  ${CYAN}theme${RESET} [action]         Theme management (toggle, light, dark, reload)
  ${CYAN}reload${RESET} [target]        Reload components (dwm, quickshell, statusbar, all)
  ${CYAN}doctor${RESET}                 Run full system health & diagnostic audit
  ${CYAN}--version, -v${RESET}          Display CLI version
  ${CYAN}--help, -h${RESET}             Display this help message

EOF
}

# ── 1. LAUNCH ────────────────────────────────────────────────────────────────
cmd_launch() {
    local target="${1:-help}"
    case "$target" in
        terminal|term)
            exec ~/.config/ml4w/settings/terminal.sh
            ;;
        browser|web)
            exec ~/.config/ml4w/settings/browser.sh
            ;;
        filemanager|files)
            exec ~/.config/ml4w/settings/filemanager
            ;;
        calculator|calc)
            exec ~/.config/ml4w/settings/calculator.sh
            ;;
        emojipicker|emoji)
            exec ~/.config/ml4w/settings/emojipicker.sh
            ;;
        launcher|drun)
            exec ~/.config/hypr/scripts/launcher.sh
            ;;
        ai|antigravity)
            exec kitty -e agy
            ;;
        settings)
            exec "$HOME/.local/bin/jeme-settings" toggle
            ;;
        *)
            echo "Unknown target '$target'. Choices: terminal, browser, filemanager, calculator, emojipicker, launcher, ai, settings"
            exit 1
            ;;
    esac
}

# ── 2. WIFI ──────────────────────────────────────────────────────────────────
cmd_wifi() {
    local action="${1:-status}"
    case "$action" in
        toggle)
            local state
            state=$(nmcli -t -f WIFI g)
            if [[ "$state" == "enabled" ]]; then
                nmcli radio wifi off
                echo "Wi-Fi disabled"
            else
                nmcli radio wifi on
                echo "Wi-Fi enabled"
            fi
            ;;
        on)
            nmcli radio wifi on
            echo "Wi-Fi enabled"
            ;;
        off)
            nmcli radio wifi off
            echo "Wi-Fi disabled"
            ;;
        status)
            nmcli -t -f WIFI,STATE g
            nmcli -t -f ACTIVE,SSID,SIGNAL dev wifi | grep '^yes' || echo "Disconnected"
            ;;
        menu)
            exec nm-connection-editor &
            ;;
        *)
            echo "Usage: jeme wifi [toggle|on|off|status|menu]"
            exit 1
            ;;
    esac
}

# ── 3. BLUETOOTH ─────────────────────────────────────────────────────────────
cmd_bluetooth() {
    local action="${1:-status}"
    case "$action" in
        toggle)
            if bluetoothctl show | grep -q "Powered: yes"; then
                bluetoothctl power off
                echo "Bluetooth powered off"
            else
                bluetoothctl power on
                echo "Bluetooth powered on"
            fi
            ;;
        on)
            bluetoothctl power on
            echo "Bluetooth powered on"
            ;;
        off)
            bluetoothctl power off
            echo "Bluetooth powered off"
            ;;
        status)
            bluetoothctl show | grep -E "Powered|Name|Alias" || echo "Bluetooth inactive"
            ;;
        menu)
            exec blueman-manager &
            ;;
        *)
            echo "Usage: jeme bluetooth [toggle|on|off|status|menu]"
            exit 1
            ;;
    esac
}

# ── 4. AUDIO ─────────────────────────────────────────────────────────────────
cmd_audio() {
    local action="${1:-status}"
    case "$action" in
        up|volume-up)
            wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
            ;;
        down|volume-down)
            wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
            ;;
        mute|toggle-mute)
            wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
            ;;
        mic-mute|toggle-mic)
            wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
            ;;
        status)
            wpctl get-volume @DEFAULT_AUDIO_SINK@
            ;;
        *)
            echo "Usage: jeme audio [up|down|mute|mic-mute|status]"
            exit 1
            ;;
    esac
}

# ── 5. BRIGHTNESS ────────────────────────────────────────────────────────────
cmd_brightness() {
    local action="${1:-get}"
    case "$action" in
        up)
            brightnessctl -e0.6 -n2 set 5%+
            ;;
        down)
            brightnessctl -e0.6 -n2 set 5%-
            ;;
        set)
            local val="${2:-50%}"
            brightnessctl set "$val"
            ;;
        get)
            brightnessctl get
            ;;
        *)
            echo "Usage: jeme brightness [up|down|set <pct>|get]"
            exit 1
            ;;
    esac
}

# ── 6. MEDIA ─────────────────────────────────────────────────────────────────
cmd_media() {
    local action="${1:-status}"
    case "$action" in
        play-pause|toggle)
            playerctl play-pause || true
            ;;
        next)
            playerctl next || true
            ;;
        prev|previous)
            playerctl previous || true
            ;;
        status)
            playerctl metadata --format "{{ artist }} - {{ title }} ({{ status }})" 2>/dev/null || echo "No active player"
            ;;
        *)
            echo "Usage: jeme media [play-pause|next|prev|status]"
            exit 1
            ;;
    esac
}

# ── 7. POWER ─────────────────────────────────────────────────────────────────
cmd_power() {
    local action="${1:-status}"
    case "$action" in
        status)
            jeme-power-switcher status
            ;;
        profile)
            local prof="${2:-}"
            if [[ -z "$prof" ]]; then
                echo "Specify profile (balanced, performance, power-saver)"
                exit 1
            fi
            jeme-power-switcher set "$prof"
            ;;
        lock)
            exec ~/Jeme-OS-DWM/scripts/lock-x11.sh
            ;;
        logout)
            pkill -TERM -u "$USER" jeme-dwm || hyprctl dispatch 'hl.dsp.exit()' || true
            ;;
        suspend)
            systemctl suspend
            ;;
        reboot)
            systemctl reboot
            ;;
        shutdown|poweroff)
            systemctl poweroff
            ;;
        *)
            echo "Usage: jeme power [status|profile <name>|lock|logout|suspend|reboot|shutdown]"
            exit 1
            ;;
    esac
}

# ── 8. SCREENSHOT ────────────────────────────────────────────────────────────
cmd_screenshot() {
    local mode="${1:-full}"
    case "$mode" in
        full)
            exec ~/Jeme-OS-DWM/scripts/screenshot-x11.sh full
            ;;
        area)
            exec ~/Jeme-OS-DWM/scripts/screenshot-x11.sh area
            ;;
        window)
            exec ~/Jeme-OS-DWM/scripts/screenshot-x11.sh window
            ;;
        *)
            exec ~/Jeme-OS-DWM/scripts/screenshot-x11.sh
            ;;
    esac
}

# ── 9. WALLPAPER ─────────────────────────────────────────────────────────────
cmd_wallpaper() {
    local action="${1:-status}"
    case "$action" in
        set)
            local img="${2:-}"
            if [[ -f "$img" ]]; then
                ~/.config/ml4w/scripts/ml4w-wallpaper "$img"
            else
                echo "File not found: $img"
                exit 1
            fi
            ;;
        random)
            ~/.config/ml4w/scripts/ml4w-wallpaper-app --random
            ;;
        toggle-engine)
            qs ipc call wallpaper-engine toggle || true
            ;;
        status)
            cat ~/.config/ml4w/settings/wallpaper 2>/dev/null || cat ~/.cache/ml4w/hyprland-dotfiles/current_wallpaper 2>/dev/null || echo "Unknown"
            ;;
        *)
            echo "Usage: jeme wallpaper [set <path>|random|toggle-engine|status]"
            exit 1
            ;;
    esac
}

# ── 10. THEME ────────────────────────────────────────────────────────────────
cmd_theme() {
    local action="${1:-toggle}"
    case "$action" in
        toggle)
            ~/.config/ml4w/scripts/ml4w-toggle-theme
            ;;
        reload)
            qs ipc call theme-manager reload || true
            pkill -USR1 jeme-dwm 2>/dev/null || true
            dunstctl reload 2>/dev/null || true
            echo "Themes reloaded"
            ;;
        *)
            echo "Usage: jeme theme [toggle|reload]"
            exit 1
            ;;
    esac
}

# ── 11. RELOAD ───────────────────────────────────────────────────────────────
cmd_reload() {
    local target="${1:-all}"
    case "$target" in
        dwm)
            pkill -USR1 jeme-dwm
            echo "DWM config reloaded"
            ;;
        restart-wm)
            pkill -HUP jeme-dwm
            echo "DWM process re-executed"
            ;;
        quickshell|qs)
            pkill -x qs 2>/dev/null || true
            pkill -f "quickshell" 2>/dev/null || true
            sleep 0.5
            qs -p ~/Jeme-OS-DWM/quickshell &
            echo "Quickshell restarted"
            ;;
        statusbar)
            qs ipc call statusbar reload || true
            echo "Statusbar reloaded"
            ;;
        all)
            pkill -USR1 jeme-dwm 2>/dev/null || true
            qs ipc call theme-manager reload 2>/dev/null || true
            qs ipc call statusbar reload 2>/dev/null || true
            dunstctl reload 2>/dev/null || true
            echo "All desktop components reloaded"
            ;;
        *)
            echo "Usage: jeme reload [dwm|restart-wm|quickshell|statusbar|all]"
            exit 1
            ;;
    esac
}

# ── 12. DOCTOR (SYSTEM AUDIT) ────────────────────────────────────────────────
cmd_doctor() {
    echo -e "\n${BOLD}======================================================${RESET}"
    echo -e "${BOLD}       JEME OS — DESKTOP HEALTH & FORENSIC AUDIT      ${RESET}"
    echo -e "${BOLD}======================================================${RESET}\n"

    # 1. Window Manager & Display
    echo -e "${BOLD}1. Window Manager & Display Server:${RESET}"
    local dwm_pid
    dwm_pid=$(pgrep -x jeme-dwm 2>/dev/null || pgrep -x dwm 2>/dev/null || true)
    if [[ -n "$dwm_pid" ]]; then
        pass "DWM window manager is active (PID: ${dwm_pid})"
    else
        fail "DWM is not running"
    fi

    if [[ -n "${DISPLAY:-}" ]]; then
        pass "X11 Display server connected (DISPLAY=${DISPLAY})"
    else
        fail "No DISPLAY environment variable set"
    fi

    if command -v wmctrl &>/dev/null && wmctrl -m &>/dev/null; then
        local wm_name
        wm_name=$(wmctrl -m 2>/dev/null | awk '/Name:/ {print $2}' || echo "dwm")
        pass "EWMH Window Manager verified and responsive (${wm_name})"
    else
        warn "EWMH compliance check skipped or wmctrl not responding"
    fi

    local hotkeys_file="$HOME/.config/jeme-dwm/hotkeys.toml"
    if [ -f "$hotkeys_file" ]; then
        local key_count
        key_count=$(python3 -c "import tomllib; d=tomllib.load(open('$hotkeys_file','rb')); print(len(d.get('keys', d.get('vars', {}).get('keys', []))))" 2>/dev/null || echo 0)
        if [ "$key_count" -gt 0 ]; then
            pass "DWM hotkeys verified (${key_count} active keybindings configured)"
        else
            warn "hotkeys.toml exists but 0 keys were parsed"
        fi
    else
        fail "hotkeys.toml missing in ~/.config/jeme-dwm/"
    fi

    # 2. Desktop Shell (Quickshell)
    echo -e "\n${BOLD}2. Desktop Shell (Quickshell):${RESET}"
    local qs_pid
    qs_pid=$(pgrep -f "qs.*quickshell" 2>/dev/null || true)
    if [[ -n "$qs_pid" ]]; then
        pass "Quickshell process active (PID: ${qs_pid})"
        local targets
        targets=$(qs ipc show 2>/dev/null | awk '/^target/ {print $2}' || true)
        if echo "$targets" | grep -q "statusbar"; then
            pass "Quickshell IPC targets verified: $(echo $targets | tr '\n' ' ')"
        else
            warn "Quickshell running but IPC targets not responding"
        fi
    else
        fail "Quickshell is not running"
    fi

    # 3. Compositor (Picom)
    echo -e "\n${BOLD}3. Compositor (Picom):${RESET}"
    if pgrep -x picom >/dev/null; then
        if xprop -root _NET_WM_CM_S0 2>/dev/null | grep -q "window id"; then
            pass "Picom compositor active with X11 composite manager registered (_NET_WM_CM_S0)"
        else
            pass "Picom compositor process active"
        fi
    else
        warn "Picom compositor is not running (falling back to uncomposited X11)"
    fi

    # 4. Audio Pipeline
    echo -e "\n${BOLD}4. Audio & Media System:${RESET}"
    if systemctl --user is-active pipewire.service >/dev/null 2>&1; then
        pass "PipeWire audio daemon active"
    else
        fail "PipeWire user service is inactive"
    fi

    if systemctl --user is-active wireplumber.service >/dev/null 2>&1; then
        pass "WirePlumber session manager active"
    else
        fail "WirePlumber is inactive"
    fi

    if command -v wpctl &>/dev/null; then
        local vol_info
        vol_info=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null || echo "")
        if [[ -n "$vol_info" ]]; then
            pass "PipeWire default audio sink functional (${vol_info})"
        else
            warn "Could not query default audio sink"
        fi
    fi

    # 5. Networking & Bluetooth
    echo -e "\n${BOLD}5. Connectivity Services:${RESET}"
    if systemctl is-active NetworkManager.service >/dev/null 2>&1; then
        local wifi_state
        wifi_state=$(nmcli radio wifi 2>/dev/null || echo "unknown")
        pass "NetworkManager active (Wi-Fi radio: ${wifi_state})"
    else
        fail "NetworkManager inactive"
    fi

    if systemctl is-active bluetooth.service >/dev/null 2>&1; then
        local bt_status="inactive"
        if bluetoothctl show 2>/dev/null | grep -q "Powered: yes"; then
            bt_status="powered on"
        else
            bt_status="powered off / no adapter"
        fi
        pass "BlueZ Bluetooth service active (${bt_status})"
    else
        warn "BlueZ Bluetooth service inactive"
    fi

    # 6. Power Management
    echo -e "\n${BOLD}6. Power Management:${RESET}"
    if systemctl --user is-active jeme-power-switcher.service >/dev/null 2>&1; then
        pass "Jeme power switcher daemon active"
    else
        warn "jeme-power-switcher user service not running"
    fi

    # 7. Hardware & GPU
    echo -e "\n${BOLD}7. Hardware & Graphics:${RESET}"
    if command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi >/dev/null 2>&1; then
        local gpu_name
        gpu_name=$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -n1)
        pass "NVIDIA GPU detected & responding (${gpu_name})"
    else
        warn "NVIDIA GPU driver query unavailable"
    fi

    # 8. Theming & Wallpapers
    echo -e "\n${BOLD}8. Theming & Customization:${RESET}"
    if command -v matugen >/dev/null 2>&1; then
        pass "Matugen theme generator installed ($(matugen --version 2>/dev/null || true))"
    else
        fail "Matugen not found in PATH"
    fi

    local wp_path=""
    if [ -f "$HOME/.cache/ml4w/hyprland-dotfiles/current_wallpaper" ]; then
        wp_path="$(cat "$HOME/.cache/ml4w/hyprland-dotfiles/current_wallpaper" 2>/dev/null)"
    elif [ -f "$HOME/.config/ml4w/settings/wallpaper" ]; then
        wp_path="$(cat "$HOME/.config/ml4w/settings/wallpaper" 2>/dev/null)"
    fi

    if [ -n "$wp_path" ] && [ -f "$wp_path" ]; then
        pass "Current wallpaper configured & verified ($(basename "$wp_path"))"
    else
        warn "Current wallpaper file missing or invalid"
    fi

    if [[ -f "$HOME/.config/jeme-dwm/themes.toml" ]]; then
        pass "DWM Matugen theme config verified (~/.config/jeme-dwm/themes.toml)"
    else
        warn "themes.toml missing"
    fi

    if pgrep -f "gtk-theme-switcher.sh" >/dev/null; then
        pass "GTK & Matugen live theme-switch listener active"
    else
        warn "gtk-theme-switcher.sh listener not running (start with ~/.config/ml4w/listeners.sh --startall)"
    fi

    # 9. Desktop Utilities & Daemons
    echo -e "\n${BOLD}9. Desktop Utilities & Daemons:${RESET}"
    if pgrep -x dunst >/dev/null; then
        if command -v dunstctl &>/dev/null && ! dunstctl is-paused >/dev/null 2>&1; then
            pass "Dunst notification daemon active and unpaused"
        else
            pass "Dunst notification daemon active"
        fi
    elif pgrep -x swaync >/dev/null; then
        pass "SwayNC notification daemon active"
    else
        warn "No notification daemon active"
    fi

    if command -v xclip >/dev/null 2>&1 && command -v cliphist >/dev/null 2>&1; then
        if pgrep -f "x11-cliphist-daemon" >/dev/null; then
            pass "xclip, cliphist & x11-cliphist-daemon fully operational"
        else
            pass "xclip & cliphist installed (daemon not running)"
        fi
    else
        warn "Clipboard utilities missing (xclip or cliphist)"
    fi

    if command -v maim &>/dev/null && command -v slop &>/dev/null; then
        pass "X11 Screenshot engine ready (maim + slop)"
    else
        warn "maim or slop missing for X11 screenshots"
    fi

    if command -v tesseract &>/dev/null; then
        pass "Tesseract OCR engine ready for text extraction"
    else
        warn "tesseract not installed (text extractor requires tesseract)"
    fi

    if [ -x "$HOME/Jeme-OS-DWM/scripts/lock-x11.sh" ] || [ -x "$HOME/.local/bin/hyprlock" ]; then
        pass "Session lock screen mechanism configured"
    else
        warn "Lock screen script not found"
    fi

    echo -e "\n${BOLD}======================================================${RESET}"
    echo -e "${BOLD}                     AUDIT COMPLETE                   ${RESET}"
    echo -e "${BOLD}======================================================${RESET}\n"
}

# ── MAIN ENTRYPOINT ──────────────────────────────────────────────────────────
main() {
    local cmd="${1:-help}"
    shift || true

    case "$cmd" in
        launch)        cmd_launch "$@" ;;
        wifi)          cmd_wifi "$@" ;;
        bluetooth|bt)  cmd_bluetooth "$@" ;;
        audio|vol)     cmd_audio "$@" ;;
        brightness)    cmd_brightness "$@" ;;
        media)         cmd_media "$@" ;;
        power)         cmd_power "$@" ;;
        screenshot)    cmd_screenshot "$@" ;;
        lock)          cmd_power lock ;;
        wallpaper|wp)  cmd_wallpaper "$@" ;;
        theme)         cmd_theme "$@" ;;
        settings)      cmd_launch settings "$@" ;;
        reload)        cmd_reload "$@" ;;
        doctor)        cmd_doctor "$@" ;;
        --version|-v)  echo "jeme version ${VERSION}" ;;
        --help|-h|help) show_help ;;
        *)
            echo "Unknown command: '$cmd'. Run 'jeme --help' for usage."
            exit 1
            ;;
    esac
}

main "$@"
