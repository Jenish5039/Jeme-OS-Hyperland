/*
 * ML4W Tray Menu
 * Generated by Matugen
 */

QMenu {
    background-color: #0e1415;
    color: #dee4e4;

    border: 1px solid #80d4dc;
    border-radius: 8px;
    padding: 6px;

    font-family: "Inter Medium";
    font-size: 14px;
    font-weight: 600;
}

QMenu::item {
    background-color: transparent;
    color: #dee4e4;

    padding: 7px 12px;
    margin: 1px 2px;
    border-radius: 5px;

    font-family: "Inter Medium";
    font-size: 14px;
    font-weight: 600;
}

QMenu::item:selected {
    background-color: #004f55;
    color: #9df0f9;
}

QMenu::item:disabled {
    color: #bec8c9;
}

QMenu::separator {
    height: 1px;
    background-color: #80d4dc;
    margin: 5px 8px;
}

QMenu::indicator {
    width: 16px;
    height: 16px;
}

QMenu::right-arrow {
    width: 12px;
    height: 12px;
}

/*
 * Qt Dialogs & Windows (e.g. hyprland-share-picker)
 */
QDialog, QMainWindow {
    background-color: #0e1415;
    color: #dee4e4;
}

QTabWidget::pane {
    border: 1px solid #3f4849;
    border-radius: 8px;
    background-color: #0e1415;
    top: -1px;
}

QTabBar::tab {
    background-color: #1a2121;
    color: #dee4e4;
    border: 1px solid #3f4849;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 7px 16px;
    margin-right: 3px;
    font-family: "Inter Medium";
    font-size: 13px;
}

QTabBar::tab:selected {
    background-color: #004f55;
    color: #9df0f9;
    border-color: #80d4dc;
    font-weight: 600;
}

QTabBar::tab:hover:!selected {
    background-color: #252b2c;
    color: #80d4dc;
}

QScrollArea {
    border: none;
    background-color: transparent;
}

QPushButton {
    background-color: #1a2121;
    color: #dee4e4;
    border: 1px solid #3f4849;
    border-radius: 6px;
    padding: 8px 14px;
    font-family: "Inter Medium";
    font-size: 13px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #303637;
    color: #80d4dc;
    border-color: #80d4dc;
}

QPushButton:pressed {
    background-color: #004f55;
    color: #9df0f9;
}

QCheckBox {
    spacing: 8px;
    color: #dee4e4;
    font-family: "Inter Medium";
    font-size: 13px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1px solid #899393;
    background-color: #1a2121;
}

QCheckBox::indicator:checked {
    background-color: #80d4dc;
    border-color: #80d4dc;
}

/*
 * Telegram & Qt File Chooser (QFileDialog)
 * Neutral Dark Minimal Styling (Completely independent of wallpaper colors)
 */
QFileDialog {
    background-color: #1a1a1d;
    color: #dedede;
    border: 1px solid #2e2e33;
    border-radius: 8px;
    font-family: "Inter Medium", sans-serif;
    font-size: 13px;
}

QFileDialog QWidget {
    color: #dedede;
    font-family: "Inter Medium", sans-serif;
    font-size: 13px;
}

QFileDialog QTreeView,
QFileDialog QListView {
    background-color: #141416;
    color: #dedede;
    border: 1px solid #2a2a2e;
    border-radius: 6px;
    outline: none;
    padding: 3px;
}

QFileDialog QTreeView::item,
QFileDialog QListView::item {
    padding: 6px 8px;
    border-radius: 4px;
    color: #dedede;
}

QFileDialog QTreeView::item:hover:!selected,
QFileDialog QListView::item:hover:!selected {
    background-color: #242429;
    color: #ffffff;
}

QFileDialog QTreeView::item:selected,
QFileDialog QListView::item:selected {
    background-color: #38404e;
    color: #ffffff;
}

QFileDialog QHeaderView::section {
    background-color: #1e1e22;
    color: #909298;
    border: none;
    border-bottom: 1px solid #2a2a2e;
    border-right: 1px solid #242428;
    padding: 6px 8px;
    font-size: 12px;
    font-weight: 600;
}

QFileDialog QSidebar,
QFileDialog QListView#sidebar {
    background-color: #1e1e22;
    color: #c0c2c8;
    border: 1px solid #2a2a2e;
    border-radius: 6px;
    padding: 4px;
}

QFileDialog QSidebar::item,
QFileDialog QListView#sidebar::item {
    padding: 7px 10px;
    border-radius: 5px;
    color: #c0c2c8;
}

QFileDialog QSidebar::item:hover:!selected,
QFileDialog QListView#sidebar::item:hover:!selected {
    background-color: #26262c;
    color: #ffffff;
}

QFileDialog QSidebar::item:selected,
QFileDialog QListView#sidebar::item:selected {
    background-color: #38404e;
    color: #ffffff;
}

QFileDialog QSplitter::handle {
    background-color: #222226;
    width: 3px;
}

QFileDialog QLabel {
    color: #9e9ea4;
    font-size: 13px;
    font-weight: 500;
}

QFileDialog QLineEdit {
    background-color: #141416;
    color: #ffffff;
    border: 1px solid #333338;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 13px;
    selection-background-color: #38404e;
}

QFileDialog QLineEdit:focus {
    border: 1px solid #4a5668;
}

QFileDialog QComboBox {
    background-color: #1e1e22;
    color: #dedede;
    border: 1px solid #333338;
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 13px;
}

QFileDialog QComboBox:hover {
    border-color: #44444a;
}

QFileDialog QComboBox:focus {
    border-color: #4a5668;
}

QFileDialog QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: none;
}

QFileDialog QToolButton {
    background-color: #1e1e22;
    color: #dedede;
    border: 1px solid #333338;
    border-radius: 6px;
    padding: 5px;
    margin: 1px;
}

QFileDialog QToolButton:hover {
    background-color: #28282e;
    border-color: #44444a;
    color: #ffffff;
}

QFileDialog QToolButton:pressed {
    background-color: #38404e;
}

QFileDialog QPushButton {
    background-color: #282d37;
    color: #ffffff;
    border: 1px solid #383f4d;
    border-radius: 6px;
    padding: 7px 18px;
    font-size: 13px;
    font-weight: 600;
    min-width: 75px;
}

QFileDialog QPushButton:hover {
    background-color: #343b48;
    border-color: #464f60;
}

QFileDialog QPushButton:pressed {
    background-color: #20242c;
}

QFileDialog QPushButton:disabled {
    background-color: #1a1c20;
    color: #55575d;
    border-color: #24262a;
}

QFileDialog QScrollBar:vertical {
    background: transparent;
    width: 7px;
    margin: 0px;
    border: none;
}

QFileDialog QScrollBar::handle:vertical {
    background: #333338;
    min-height: 24px;
    border-radius: 3px;
}

QFileDialog QScrollBar::handle:vertical:hover {
    background: #44444c;
}

QFileDialog QScrollBar::add-line:vertical,
QFileDialog QScrollBar::sub-line:vertical {
    height: 0px;
    border: none;
    background: none;
}

QFileDialog QScrollBar::add-page:vertical,
QFileDialog QScrollBar::sub-page:vertical {
    background: none;
}


