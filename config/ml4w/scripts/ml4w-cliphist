#!/usr/bin/env bash
#   ____ _ _       _     _     _
#  / ___| (_)_ __ | |__ (_)___| |_
# | |   | | | '_ \| '_ \| / __| __|
# | |___| | | |_) | | | | \__ \ |_
#  \____|_|_| .__/|_| |_|_|___/\__|
#           |_|
#
# -----------------------------------------------------
# Load Launcher
# -----------------------------------------------------
# Release statusbar focus grab if active so keyboard reaches rofi
qs ipc call statusbar collapse 2>/dev/null || true

if [ "$launcher" == "walker" ]; then
    $HOME/.config/walker/launch.sh -m clipboard -N -H
else
    case $1 in
        d)
            selected=$(cliphist list | rofi -dmenu -replace -config ~/.config/rofi/config-cliphist.rasi)
            [ -z "$selected" ] && exit 0
            echo "$selected" | cliphist delete
        ;;
        w)
            cliphist wipe
        ;;
        *)
            selected=$(cliphist list | rofi -dmenu -replace -config ~/.config/rofi/config-cliphist.rasi)
            [ -z "$selected" ] && exit 0
            echo "$selected" | cliphist decode | wl-copy
        ;;
    esac
fi