#!/usr/bin/env python3
"""
Jeme Wallpaper Engine Backend Manager (Waywallen / Open Wallpaper Engine Backend)
Provides dynamic Steam Workshop wallpaper discovery, persistent mode tracking,
layer-shell background orchestration via Waywallen daemon & layer-shell, Matugen theming bridge,
and intelligent power management (auto-pause on fullscreen, lockscreen, DPMS sleep, and battery policy).
"""

import sys
import os
import glob
import json
import time
import signal
import socket
import select
import sqlite3
import threading
import subprocess
from pathlib import Path

# --- CACHE & CONFIG LOCATIONS ---
CACHE_DIR = Path.home() / ".cache" / "ml4w" / "wallpaper-engine"
CACHE_DIR.mkdir(parents=True, exist_ok=True)
THUMBNAIL_DIR = CACHE_DIR / "thumbnails"
THUMBNAIL_DIR.mkdir(parents=True, exist_ok=True)

STATE_FILE = CACHE_DIR / "state.json"
LIST_CACHE_FILE = CACHE_DIR / "wallpapers.json"
DAEMON_PID_FILE = CACHE_DIR / "power_daemon.pid"

SETTINGS_DIR = Path.home() / ".config" / "ml4w" / "settings"
SETTINGS_DIR.mkdir(parents=True, exist_ok=True)
MODE_FILE = SETTINGS_DIR / "wallpaper-mode"
CONFIG_FILE = SETTINGS_DIR / "wallpaper-engine-config.json"
BATTERY_POLICY_FILE = SETTINGS_DIR / "wallpaper-engine-battery-policy"
FAVORITES_FILE = SETTINGS_DIR / "wallpaper-engine-favorites.json"
RECENTS_FILE = SETTINGS_DIR / "wallpaper-engine-recents.json"


def get_favorites():
    """Retrieve persisted list of favorite wallpaper IDs."""
    if FAVORITES_FILE.is_file():
        try:
            with open(FAVORITES_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)
                if isinstance(data, list):
                    return [str(x) for x in data]
        except Exception:
            pass
    return []


def save_favorites(fav_list):
    """Persist list of favorite wallpaper IDs."""
    try:
        clean = []
        for x in fav_list:
            sx = str(x).strip()
            if sx and sx not in clean:
                clean.append(sx)
        with open(FAVORITES_FILE, "w", encoding="utf-8") as f:
            json.dump(clean, f, indent=2)
        return clean
    except Exception:
        return fav_list


def add_favorite(target_id):
    """Add wallpaper ID to favorites."""
    target_id = str(target_id).strip()
    favs = get_favorites()
    if target_id and target_id not in favs:
        favs.append(target_id)
        save_favorites(favs)
    return favs


def remove_favorite(target_id):
    """Remove wallpaper ID from favorites."""
    target_id = str(target_id).strip()
    favs = get_favorites()
    if target_id in favs:
        favs = [x for x in favs if x != target_id]
        save_favorites(favs)
    return favs


def toggle_favorite(target_id):
    """Toggle favorite status of wallpaper ID."""
    target_id = str(target_id).strip()
    favs = get_favorites()
    if target_id in favs:
        favs = [x for x in favs if x != target_id]
        is_fav = False
    else:
        if target_id:
            favs.append(target_id)
        is_fav = True
    save_favorites(favs)
    return {"is_favorite": is_fav, "favorites": favs}


def get_recents():
    """Retrieve persisted list of recently used wallpaper IDs."""
    if RECENTS_FILE.is_file():
        try:
            with open(RECENTS_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)
                if isinstance(data, list):
                    return [str(x) for x in data]
        except Exception:
            pass
    return []


def record_recent(target_id, max_items=20):
    """Record wallpaper ID as most recently used."""
    target_id = str(target_id).strip()
    if not target_id:
        return get_recents()
    recents = get_recents()
    recents = [x for x in recents if x != target_id]
    recents.insert(0, target_id)
    recents = recents[:max_items]
    try:
        with open(RECENTS_FILE, "w", encoding="utf-8") as f:
            json.dump(recents, f, indent=2)
    except Exception:
        pass
    return recents


