#!/usr/bin/env bash
# ==============================================================================
# Jeme OS — Display & Density Profile Switcher
# Allows seamless switching between:
#   1. compact-100 (Native 1:1 Scale 1.0, compact integer-aligned shell)
#   2. original-083 (Scale 0.8333, 2304x1296 logical canvas)
# ==============================================================================
set -euo pipefail

PROFILES_DIR="${HOME}/.config/jeme-profiles"
ACTIVE_FILE="${PROFILES_DIR}/active"
BACKUP_DIR="${HOME}/.config/jeme-backups"

# Colors for CLI output
GREEN="\033[1;32m"
BLUE="\033[1;34m"
YELLOW="\033[1;33m"
CYAN="\033[1;36m"
RED="\033[1;31m"
BOLD="\033[1m"
RESET="\033[0m"

get_active_profile() {
    if [[ -f "$ACTIVE_FILE" ]]; then
        cat "$ACTIVE_FILE"
    else
        echo "compact-100"
    fi
}

show_status() {
    local active
    active="$(get_active_profile)"
    echo -e "${BOLD}Jeme OS Display Profiles${RESET}"
    echo -e "──────────────────────────────────────────────"
    if [[ "$active" == "compact-100" ]]; then
        echo -e "  Active Profile : ${GREEN}${BOLD}compact-100${RESET} (Native 1:1 @ 1080p, Compact UI)"
        echo -e "  Monitor Scale  : 1.0 (Pixel-Perfect Scanout)"
        echo -e "  Topbar / Dock  : 30px height (38px res) / 46px height (52px res)"
        echo -e "  Gaps (In/Out)  : 6px / 10px"
        echo -e "  GTK Text Scale : 1.0"
    else
        echo -e "  Active Profile : ${YELLOW}${BOLD}original-083${RESET} (Scale 0.8333, Virtual 2304x1296)"
        echo -e "  Monitor Scale  : 0.8333333"
        echo -e "  Topbar / Dock  : 38px height (50px res) / 56px height (76px res)"
        echo -e "  Gaps (In/Out)  : 10px / 20px"
        echo -e "  GTK Text Scale : 1.15"
    fi
    echo -e "──────────────────────────────────────────────"
    echo -e "Available Commands:"
    echo -e "  ${CYAN}jeme-profile compact${RESET}   -> Switch to 1.0 native compact profile"
    echo -e "  ${CYAN}jeme-profile original${RESET}  -> Switch to 0.8333 original profile"
    echo -e "  ${CYAN}jeme-profile toggle${RESET}    -> Toggle between profiles"
    echo -e "  ${CYAN}jeme-profile status${RESET}    -> Show this status screen"
}

apply_profile() {
    local target="$1"
    local src_dir="${PROFILES_DIR}/${target}"

    if [[ ! -d "$src_dir" ]]; then
        echo -e "${RED}Error:${RESET} Profile '${target}' not found at ${src_dir}"
        exit 1
    fi

    local env_file="${src_dir}/profile.env"
    if [[ -f "$env_file" ]]; then
        # shellcheck source=/dev/null
        source "$env_file"
    else
        echo -e "${RED}Error:${RESET} Missing profile.env in ${src_dir}"
        exit 1
    fi

    echo -e "${BLUE}Switching Jeme OS profile to:${RESET} ${BOLD}${PROFILE_NAME}${RESET}"
    echo -e "  -> ${PROFILE_DESCRIPTION}"

    # 1. Create safety backup of current configs
    local timestamp
    timestamp="$(date +%Y%m%d-%H%M%S)"
    local pre_switch_dir="${BACKUP_DIR}/switch-${timestamp}"
    mkdir -p "$pre_switch_dir"

    # Copy files to ~/.config/
    echo -e "  -> Deploying configuration files..."
    cp -r "${src_dir}/hypr" "${HOME}/.config/"
    cp -r "${src_dir}/quickshell" "${HOME}/.config/"
    cp -r "${src_dir}/kitty" "${HOME}/.config/"
    cp -r "${src_dir}/ml4w" "${HOME}/.config/"

    # Also mirror to Jeme OS Rice repo if present
    if [[ -d "${HOME}/Jeme OS Rice/config" ]]; then
        cp -r "${src_dir}/hypr" "${HOME}/Jeme OS Rice/config/" 2>/dev/null || true
        cp -r "${src_dir}/quickshell" "${HOME}/Jeme OS Rice/config/" 2>/dev/null || true
        cp -r "${src_dir}/kitty" "${HOME}/Jeme OS Rice/config/" 2>/dev/null || true
        cp -r "${src_dir}/ml4w" "${HOME}/Jeme OS Rice/config/" 2>/dev/null || true
    fi

    # 2. Apply GTK text scaling
    if command -v gsettings &>/dev/null; then
        echo -e "  -> Setting GTK text-scaling-factor to ${GTK_TEXT_SCALE}..."
        gsettings set org.gnome.desktop.interface text-scaling-factor "$GTK_TEXT_SCALE" 2>/dev/null || true
    fi

    # 3. Apply live Hyprland monitor scale
    if command -v hyprctl &>/dev/null && pgrep -x Hyprland &>/dev/null; then
        echo -e "  -> Applying Hyprland monitor scale (${MONITOR_SCALE})..."
        hyprctl keyword monitor "eDP-1,1920x1080@144.00Hz,0x0,${MONITOR_SCALE}" &>/dev/null || true
        hyprctl reload &>/dev/null || true
    fi

    # 4. Reload Quickshell Statusbar & Theme
    if command -v qs &>/dev/null; then
        echo -e "  -> Reloading Quickshell statusbar and theme..."
        qs ipc call statusbar reload &>/dev/null || true
        qs ipc call theme-manager reload &>/dev/null || true
        qs ipc call dock reload &>/dev/null || true
    fi

    # 5. Reload Kitty terminals
    pkill -USR1 kitty 2>/dev/null || true

    # 6. Save active state
    echo "$PROFILE_NAME" > "$ACTIVE_FILE"

    # 7. Desktop notification
    if command -v notify-send &>/dev/null; then
        notify-send "Jeme OS Profile Switched" "${PROFILE_DESCRIPTION}" -i display -t 3000 || true
    fi

    echo -e "${GREEN}${BOLD}✓ Profile applied successfully!${RESET}"
}

toggle_profile() {
    local active
    active="$(get_active_profile)"
    if [[ "$active" == "compact-100" ]]; then
        apply_profile "original-083"
    else
        apply_profile "compact-100"
    fi
}

case "${1:-status}" in
    compact|1.0|1|compact-100)
        apply_profile "compact-100"
        ;;
    original|0.83|0.8333|0.8|original-083)
        apply_profile "original-083"
        ;;
    toggle)
        toggle_profile
        ;;
    status)
        show_status
        ;;
    help|-h|--help)
        show_status
        ;;
    *)
        echo -e "${RED}Unknown command:${RESET} $1"
        echo -e "Use: jeme-profile [compact|original|toggle|status]"
        exit 1
        ;;
esac
